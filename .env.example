# GiControl — copie este arquivo para `.env` e preencha localmente.

# Supabase > Connect > Session pooler
DATABASE_URL=postgresql://postgres.[PROJECT_REF]:[PASSWORD]@[HOST]:5432/postgres?sslmode=require

# Supabase > Project Settings > API (usados na futura autenticação)
SUPABASE_URL=https://[PROJECT_REF].supabase.co
SUPABASE_ANON_KEY=[SUPABASE_ANON_KEY]
SUPABASE_SERVICE_ROLE_KEY=[SUPABASE_SERVICE_ROLE_KEY]

# Frontend Vite — use a mesma URL e a chave pública/anon acima
VITE_SUPABASE_URL=https://[PROJECT_REF].supabase.co
VITE_SUPABASE_ANON_KEY=[SUPABASE_ANON_KEY]

# Em produção mantenha sempre habilitado
AUTH_REQUIRED=true
